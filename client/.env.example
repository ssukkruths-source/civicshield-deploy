# CIVICSHIELD FRONTEND CONFIGURATION
# In local development, the Vite server proxies /api to http://localhost:5000 automatically.
# In production on Vercel, set VITE_API_BASE_URL to your deployed Render backend URL.
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Optional: Supabase Public Anon Configuration if client queries Supabase Auth directly
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
