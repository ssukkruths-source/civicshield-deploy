# CIVICSHIELD BACKEND CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# SUPABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# IMPORTANT: Service Role Key is used on backend for trusted administrative queries
# DO NOT expose this key in frontend code!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional Public Anon Key
SUPABASE_ANON_KEY=your_anon_key_here
